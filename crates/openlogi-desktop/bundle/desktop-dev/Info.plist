<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The dev app's Info.plist template. The shipped app's is generated by
     cargo-bundle from Cargo.toml, so this is the only checked-in one.
     CFBundleName / CFBundleDisplayName / CFBundleIdentifier are deliberately
     absent: `xtask macos dev-bundle` stamps the dev identity derived from
     openlogi_core::brand, and verifies what it stamped. -->
<plist version="1.0">
<dict>
  <key>CFBundleExecutable</key><string>openlogi-desktop</string>
  <key>CFBundleIconFile</key><string>AppIcon</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <!-- 0.0.0 = the repo-wide "unstamped dev build" sentinel (release versions
       come from cargo-bundle / xtask stamping). -->
  <key>CFBundleShortVersionString</key><string>0.0.0</string>
  <key>CFBundleVersion</key><string>0.0.0</string>
  <key>LSMinimumSystemVersion</key><string>13.0</string>
  <key>NSHighResolutionCapable</key><true/>
  <key>NSCameraUsageDescription</key><string>OpenLogi previews your Logitech webcam locally. Video never leaves your Mac.</string>
  <!-- openlogi:// deep-link scheme. Mirror of [package.metadata.bundle]
       osx_url_schemes in Cargo.toml (which cargo-bundle uses for the release
       app) — keep the two in sync. CFBundleURLName matches the name
       cargo-bundle generates (the bundle name, not the identifier) so dev and
       release register the type identically. -->
  <key>CFBundleURLTypes</key>
  <array>
    <dict>
      <key>CFBundleURLName</key><string>OpenLogi</string>
      <key>CFBundleURLSchemes</key>
      <array>
        <string>openlogi</string>
      </array>
    </dict>
  </array>
</dict>
</plist>
