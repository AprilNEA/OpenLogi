+#[derive(Clone)]
+struct ScriptedRawHidHandle {
+    written: Arc<Mutex<Vec<Vec<u8>>>>,
+}
+
+impl ScriptedRawHidHandle {
+    fn written_reports(&self) -> Vec<Vec<u8>> {
