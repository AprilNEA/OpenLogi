+        };
+        let Some(identifier) = plist
+            .as_dictionary()
+            .and_then(|dictionary| dictionary.get("CFBundleIdentifier"))
+            .and_then(plist::Value::as_string)
+        else {
+            continue;
+        };
+        return Some(identifier.to_owned());
+    }
