#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

# Prints each argument that dpkg does not report as installed.
missing_packages() {
  local package
  for package in "$@"; do
    if ! dpkg-query -W -f='${db:Status-Status}' "$package" 2>/dev/null | grep -Fqx installed; then
      printf '%s\n' "$package"
    fi
  done
}

# Sets `sudo` to the command prefix for root-only steps, or exits when none works.
require_root() {
  if ((EUID == 0)); then
    sudo=()
  elif command -v sudo >/dev/null 2>&1 && sudo -n true; then
    sudo=(sudo -n)
  else
    echo "Passwordless sudo is required to install: $*" >&2
    exit 1
  fi
}

apt_updated=0
apt_install() {
  require_root "$@"
  if ((! apt_updated)); then
    "${sudo[@]}" apt-get update
    apt_updated=1
  fi
  "${sudo[@]}" env DEBIAN_FRONTEND=noninteractive apt-get install -y "$@"
}

step_started=$SECONDS
echo "==> Checking Linux build dependencies"
packages=(
  libudev-dev
  gcc
  g++
  clang
  libfontconfig-dev
  libwayland-dev
  libxkbcommon-x11-dev
  libx11-xcb-dev
  libssl-dev
  libzstd-dev
  pkg-config
)
mapfile -t missing < <(missing_packages "${packages[@]}")
if ((${#missing[@]})); then
  apt_install "${missing[@]}"
else
  echo "    Linux build dependencies are already installed"
fi
echo "    completed in $((SECONDS - step_started))s"

# The orb Desktop is a Wayland compositor. grim captures it, wtype types into it,
# and wlrctl moves and clicks the pointer. See "Headless rendering in a sandbox"
# in docs/DEVELOPMENT.md and .agents/scripts/orb-gui.sh.
step_started=$SECONDS
echo "==> Checking orb Desktop capture tools"
if [[ "$(uname -s)" != Linux ]] || ! command -v apt-get >/dev/null 2>&1; then
  echo "    skipped: this step needs apt-get on Linux"
else
  wlrctl_bin=/usr/local/bin/wlrctl
  wlrctl_version=v0.2.2
  packages=(grim wtype)
  if [[ ! -x $wlrctl_bin ]]; then
    # Debian 12 has no wlrctl package. Its build dependencies stay installed:
    # they are small, and removing them would only make a rebuild reinstall them.
    packages+=(meson ninja-build libxkbcommon-dev)
  fi
  mapfile -t missing < <(missing_packages "${packages[@]}")
  if ((${#missing[@]})); then
    apt_install "${missing[@]}"
  fi

  if [[ ! -x $wlrctl_bin ]]; then
    wlrctl_src="$(mktemp -d)"
    git -c advice.detachedHead=false clone --quiet --depth 1 \
      --branch "$wlrctl_version" https://git.sr.ht/~brocellous/wlrctl "$wlrctl_src"
    meson setup "$wlrctl_src/build" "$wlrctl_src" \
      -Dman-pages=disabled -Dzsh-completions=false >/dev/null
    ninja -C "$wlrctl_src/build" >/dev/null
    require_root wlrctl
    "${sudo[@]}" install -m 0755 "$wlrctl_src/build/wlrctl" "$wlrctl_bin"
    rm -rf "$wlrctl_src"
    echo "    installed wlrctl $wlrctl_version to $wlrctl_bin"
  elif ((! ${#missing[@]})); then
    echo "    grim, wtype, and wlrctl are already installed"
  fi
fi
echo "    completed in $((SECONDS - step_started))s"

step_started=$SECONDS
echo "==> Installing the Rust toolchain"
if [[ -f "$HOME/.cargo/env" ]]; then
  # shellcheck disable=SC1091
  source "$HOME/.cargo/env"
fi
if ! command -v rustup >/dev/null 2>&1; then
  curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs |
    sh -s -- -y --profile minimal --default-toolchain none --no-modify-path
  # shellcheck disable=SC1091
  source "$HOME/.cargo/env"
fi

profile_marker="# OpenLogi orb Rust toolchain"
if ! grep -Fqx "$profile_marker" "$HOME/.bash_profile" 2>/dev/null; then
  cat >>"$HOME/.bash_profile" <<'EOF'

# OpenLogi orb Rust toolchain
if [ -f "$HOME/.cargo/env" ]; then
  . "$HOME/.cargo/env"
fi
EOF
fi

rustup toolchain install stable \
  --profile minimal \
  --component rustfmt \
  --component clippy \
  --target x86_64-pc-windows-gnu
echo "    completed in $((SECONDS - step_started))s"

step_started=$SECONDS
echo "==> Installing mbx"
# mbx shares compiled crates across every checkout and worktree and prunes its
# own storage, so parallel agent worktrees neither rebuild from scratch nor
# fill the disk.
mbx_version=1.29.1
mbx_sha256=ca95f28c77711845c0455839792ca3f3070bdf007979ab75bf7e10c03b07fe3f
mbx="$HOME/.local/bin/mbx"
if [[ "$("$mbx" --version 2>/dev/null)" != "mbx $mbx_version" ]]; then
  mbx_download="$(mktemp -d)"
  curl --proto '=https' --tlsv1.2 -fsSL -o "$mbx_download/mbx.tar.gz" \
    "https://github.com/jdx/mr-boxington/releases/download/v$mbx_version/mbx-x86_64-unknown-linux-gnu.tar.gz"
  echo "$mbx_sha256  $mbx_download/mbx.tar.gz" | sha256sum --check --quiet
  tar -xzf "$mbx_download/mbx.tar.gz" -C "$mbx_download" mbx
  install -D -m 755 "$mbx_download/mbx" "$mbx"
  rm -rf "$mbx_download"
fi
"$mbx" setup

# Appended after the Rust toolchain block so the shim precedes ~/.cargo/bin.
mbx_profile_marker="# OpenLogi orb mbx Cargo shim"
if ! grep -Fqx "$mbx_profile_marker" "$HOME/.bash_profile" 2>/dev/null; then
  cat >>"$HOME/.bash_profile" <<'EOF'

# OpenLogi orb mbx Cargo shim
case ":$PATH:" in
  *":$HOME/.local/share/mbx/bin:"*) ;;
  *) PATH="$HOME/.local/share/mbx/bin:$PATH" ;;
esac
EOF
fi
echo "    completed in $((SECONDS - step_started))s"

step_started=$SECONDS
echo "==> Fetching locked Cargo dependencies for this host"
host_target="$(rustc -vV | sed -n 's/^host: //p')"
cargo fetch --locked --target "$host_target"
echo "    completed in $((SECONDS - step_started))s"

# Amp orbs default to committing as `Amp <amp@ampcode.com>`, and the orb's global
# prepare-commit-msg hook appends a Co-authored-by trailer. OpenLogi commits must
# carry the human author and no AI attribution (see "Git & GitHub" in AGENTS.md).
# Setup cannot choose an identity: its output is shared by everyone's orbs.
if [[ "$(git config user.email || true)" == amp@ampcode.com ]]; then
  cat <<'EOF'

!!! Git identity is `Amp <amp@ampcode.com>`. Before committing, set the human
!!! author with `git config user.name` and `git config user.email` in this
!!! checkout (or choose a personal default with `manage_amp git_identity`), and
!!! stop the orb hook's Co-authored-by trailer, which `--amend` re-adds:
!!! git config core.hooksPath "$(git rev-parse --path-format=absolute --git-common-dir)/hooks"

EOF
fi

echo "==> OpenLogi orb setup complete"
